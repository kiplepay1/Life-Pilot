# ─────────────────────────────────────────────
# Firebase Web App Config (safe to expose client-side —
# these are NOT secrets; Firestore security rules are what
# actually protect data)
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=

# NOTE: there is no VITE_FIREBASE_STORAGE_BUCKET here on purpose — this
# build does not use Firebase Storage (it requires the paid Blaze plan
# even for $0 usage). See README "Why there's no Firebase Storage here".
