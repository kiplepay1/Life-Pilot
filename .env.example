# ─────────────────────────────────────────────
# Firebase Web App Config (safe to expose client-side —
# these are NOT secrets, Firestore/Storage security rules
# are what actually protect data)
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────
# Cloud Functions server-side secrets
# (set via `firebase functions:secrets:set GEMINI_API_KEY`,
#  NEVER put the real value in this repo or in functions/.env)
# ─────────────────────────────────────────────
GEMINI_API_KEY=
