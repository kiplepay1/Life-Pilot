rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// LIFEPILOT — STORAGE SECURITY RULES
//
// All user files live under /users/{uid}/documents/{fileName}.
// Only the owning user may read or write their own files. The admin has
// NO storage access — document files are personal data, same as any
// Firestore subcollection. Uploads are capped in size and restricted to
// safe content types.
// ═══════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidUpload() {
      return request.resource.size < 15 * 1024 * 1024 // 15MB cap
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /users/{uid}/documents/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidUpload();
      allow delete: if isOwner(uid);
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
