rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// PLATZ BUDGET — FIRESTORE SECURITY RULES
// (evolved from the LifePilot codebase; same security model throughout)
//
// Core guarantee enforced here (not just in the UI):
//   1. A user can read/write ONLY their own data (request.auth.uid == uid).
//   2. The Super Admin (a plain `isAdmin: true` field on their own
//      /users/{uid} doc) can read/write ONLY account-metadata fields on
//      /users/{uid} — never any subcollection that holds personal/
//      financial/AI data, and never arbitrary fields on the profile doc
//      itself (e.g. cannot silently rewrite someone's currency or phone
//      number).
//   3. A normal user can never grant themselves admin from the client —
//      the owner-update rule below rejects any change to `isAdmin`.
//      The ONLY way to grant it is editing the field directly in the
//      Firebase Console's Firestore data viewer (which runs with
//      project-owner privileges and bypasses these rules entirely) —
//      by design, so this works on the free Spark plan with no Cloud
//      Functions or custom claims involved.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // Admin status lives on the caller's OWN profile document as a
      // plain `isAdmin` boolean field — not a Firebase Auth custom
      // claim. This means granting admin is as simple as opening
      // Firestore in the Firebase Console and setting isAdmin: true
      // on a user's doc by hand (which bypasses these rules entirely,
      // since Console edits use project-owner privileges) — no Cloud
      // Functions, no Blaze plan, no custom-claims code required.
      //
      // A normal user can NEVER set this field on themselves through
      // the app: the owner-update rule below explicitly requires
      // isAdmin to stay unchanged on any client-submitted update.
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApproved(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved';
    }

    // Fields the admin is permitted to touch on a user's profile doc.
    // Anything outside this set (fullName, email, phone, country,
    // currency, etc.) is untouchable by the admin — those are only
    // ever written by the owning user themselves.
    function adminOnlyTouchesAccountFields() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['status', 'approvedAt', 'approvedBy', 'rejectedAt', 'suspendedAt', 'lastStatusChangeBy']);
    }

    // ── /users/{uid} — account metadata only ─────────────────────────
    // Personal financial/life data NEVER lives on this document; it
    // lives exclusively in the subcollections below, which have no
    // admin access rule at all.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Users may create their own profile (always starting as
      // 'pending' — never self-approved), and may update most of their
      // own fields, but may never grant themselves admin or change
      // their own status from the client. Those transitions only ever
      // happen via a direct edit in the Firebase Console (bypasses
      // these rules) or an admin's approve/reject/suspend/reactivate
      // action further down.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isAdmin == false;

      allow update: if (isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.isAdmin == resource.data.isAdmin
          && request.resource.data.status == resource.data.status)
        || (isAdmin() && adminOnlyTouchesAccountFields());

      allow delete: if false; // account deletion is a manual Console action

      // ── Personal subcollections — OWNER ONLY. No admin match exists
      // for any of these, anywhere in this file, on purpose. ──────────
      match /income/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /expenses/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /bills/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /subscriptions/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /savings/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /transactions/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /tasks/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /vehicles/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /documents/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /notifications/{docId} {
        allow read, write: if isOwner(uid);
      }
      // AI conversations are now computed entirely client-side (no
      // Cloud Function / paid Gemini calls), so they're owner-only
      // read/write just like every other personal subcollection.
      match /aiConversations/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /reports/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // ── Platz Budget additions: Grab Driver, Assets/Liabilities,
      // Financial Settings — same owner-only pattern, no admin rule. ──
      match /grabSessions/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /grabTrips/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /demandObservations/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /fuelLogs/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /assets/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /liabilities/{docId} {
        allow read, write: if isOwner(uid);
      }
      // Financial settings (salary, targets, future-scenario config)
      // deliberately live here — in a subcollection with NO admin rule
      // — rather than as fields on the /users/{uid} doc itself, which
      // the admin CAN read for account metadata. This keeps every
      // dollar figure, including configured targets, fully private.
      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Anything not explicitly matched above is denied by default
    // (Firestore rules are default-deny).
  }
}
